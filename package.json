{
  "name": "sleep-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Stateless Cloudflare Workers MCP clock and bounded asynchronous sleep",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "XDG_CONFIG_HOME=.wrangler-home WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "XDG_CONFIG_HOME=.wrangler-home WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist",
    "smoke": "node scripts/smoke.ts",
    "long-smoke": "node scripts/long-smoke.ts",
    "client": "node scripts/client.ts",
    "load": "node scripts/load.ts",
    "remote-smoke": "node scripts/remote-smoke.ts",
    "deploy": "XDG_CONFIG_HOME=.wrangler-home WRANGLER_LOG_PATH=.wrangler/logs WRANGLER_SEND_METRICS=false wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@cloudflare/workers-types": "5.20261001.1",
    "@types/node": "26.6.3",
    "typescript": "7.0.2",
    "wrangler": "4.146.0"
  }
}
